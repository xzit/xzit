---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AllPosts from '../components/blocks/AllPosts.astro';
import Links from '../components/blocks/Links.astro';
import Features from '../components/blocks/Features.astro';
import Signature from "../components/Signature.astro"

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { Markdoc } from '@astrojs/markdoc/config';
const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();

export const prerender = true;

const posts = await getCollection('posts');
---

<Layout
  title={home?.seoTitle || "Xzit"}
  description={home?.seoDescription}
>
  <Signature />
  <div class="flex flex-col gap-4">
    <h1>{home?.title} <span class="animate-cursor text-sm align-top">█</span></h1>
    <div set:html={Markdoc.renderers.html(
      Markdoc.transform(home?.description?.node as any),
    )} />
  </div>
  {
    home?.content?.map((block) => {
      if (block.discriminant === 'posts' && posts.length > 0) {
        return <AllPosts posts={posts} title={block.value?.title} />;
      }
      if (block.discriminant === 'links' && block.value?.links.length > 0) {
        return <Links links={block.value?.links} title={block.value?.title} />;
      }
      if (block.discriminant === 'features' && block.value?.category.length > 0) {
        return <Features category={block.value?.category} title={block.value?.title} />;
      }
      return null;
    })
  }
</Layout>
